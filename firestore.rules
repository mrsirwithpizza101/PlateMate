rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function authed() { return request.auth != null; }

    // Public cooking profiles (location is stored rounded to ~3 miles)
    match /users/{uid} {
      allow read: if authed();
      allow create, update: if authed() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name','age','bio','av','vibe','pantry','photo','lat','lng','gh4','blocked','updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
        && request.resource.data.age is int && request.resource.data.age >= 18 && request.resource.data.age <= 120
        && request.resource.data.pantry is list && request.resource.data.pantry.size() <= 80
        && (!('bio' in request.resource.data) || (request.resource.data.bio is string && request.resource.data.bio.size() <= 300))
        && (!('photo' in request.resource.data) || request.resource.data.photo == null
            || (request.resource.data.photo is string && request.resource.data.photo.size() < 300000));
      allow delete: if authed() && request.auth.uid == uid;
    }

    // "I want to cook recipe X with person Y" — id is from_to_recipe
    match /likes/{id} {
      allow create, update: if authed() && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string && request.resource.data.rid is string
        && id == request.auth.uid + '_' + request.resource.data.to + '_' + request.resource.data.rid;
      allow get: if authed() && (resource == null || resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow list: if authed() && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      allow delete: if authed() && resource.data.from == request.auth.uid;
    }

    // A match only exists if BOTH people liked the same recipe with each other
    match /matches/{mid} {
      allow get: if authed() && (resource == null || request.auth.uid in resource.data.users);
      allow list: if authed() && request.auth.uid in resource.data.users;
      allow create: if authed()
        && request.resource.data.users is list && request.resource.data.users.size() == 2
        && request.auth.uid in request.resource.data.users
        && mid == request.resource.data.users[0] + '_' + request.resource.data.users[1] + '_' + request.resource.data.rid
        && exists(/databases/$(db)/documents/likes/$(request.resource.data.users[0] + '_' + request.resource.data.users[1] + '_' + request.resource.data.rid))
        && exists(/databases/$(db)/documents/likes/$(request.resource.data.users[1] + '_' + request.resource.data.users[0] + '_' + request.resource.data.rid));
      allow update: if authed() && request.auth.uid in resource.data.users
        && request.resource.data.users == resource.data.users
        && request.resource.data.rid == resource.data.rid;

      match /messages/{msg} {
        allow read: if authed() && request.auth.uid in get(/databases/$(db)/documents/matches/$(mid)).data.users;
        allow create: if authed() && request.resource.data.from == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
          && request.auth.uid in get(/databases/$(db)/documents/matches/$(mid)).data.users
          && get(/databases/$(db)/documents/matches/$(mid)).data.get('closed', false) == false;
      }
    }

    match /reports/{id} {
      allow create: if authed() && request.resource.data.by == request.auth.uid;
    }
  }
}
